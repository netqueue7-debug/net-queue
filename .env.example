# Postgres connection string (Neon: use the pooled connection string from your project dashboard).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"

# Twilio Verify (OTP). Account SID/Auth Token from the Console dashboard;
# Verify Service SID from Verify > Services (requires an upgraded, non-trial account).
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_VERIFY_SERVICE_SID="VA..."

# Twilio Messages API (SMS notifications — promoted/demoted/canceled, see
# docs/architecture.md#notifications). Separate from Verify above: create a
# Messaging Service under Messaging > Services and use its SID here. Until
# this is set, every notification SMS fails and retries harmlessly (logged,
# never blocks the queue mutation that triggered it) — see
# lib/notifications/sms.ts.
TWILIO_MESSAGING_SERVICE_SID="MG..."

# Cloudflare Turnstile (CAPTCHA on the OTP send endpoint). Get real keys from
# the Cloudflare dashboard: Turnstile > Add a site. Until the phone-entry UI
# exists, the values below are Cloudflare's published test keys (always pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Vercel Blob (profile picture uploads, lib/settings/avatar.ts). Vercel's
# default auth for a connected store is OIDC, not a static token: create a
# store, then on the store's Projects tab click "Connect to Project" — this
# auto-injects BLOB_STORE_ID + VERCEL_OIDC_TOKEN into your deployed
# environments, and the @vercel/blob SDK reads them automatically (no code
# needs to reference them). For local dev, don't hand-copy anything into
# this file — run `vercel link` once (if not already linked) then
# `vercel env pull .env.local`, which writes both vars for you; the SDK
# auto-refreshes the OIDC token via your Vercel CLI login as it expires.
# A static BLOB_READ_WRITE_TOKEN is only needed for code running outside
# Vercel (CI, another host) or client-side browser uploads — neither
# applies here. Until the store is connected and pulled, avatar uploads
# fail with a 502 (name/phone settings still work fine without it).
