// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  member
  admin
}

enum SignerType {
  user
  guest
}

model User {
  id                String    @id @default(cuid())
  phone             String    @unique
  // Null until First-login onboarding completes.
  displayName       String?   @map("display_name")
  role              Role      @default(member)
  waiverAcceptedAt  DateTime? @map("waiver_accepted_at")
  waiverVersion     Int?      @map("waiver_version")
  bannedAt          DateTime? @map("banned_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  waiverSignatures WaiverSignature[]
  eventLogEntries  EventLog[]
  sessions         Session[]

  @@map("users")
}

// The client only ever holds `tokenHash`'s pre-image (the raw cookie value);
// the DB stores the hash so a DB leak alone can't be used to impersonate a session.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// signerType == guest signatures aren't linked to a `guests` row yet —
// the guests table doesn't exist until Phase 2.
model WaiverSignature {
  id            String     @id @default(cuid())
  waiverVersion Int        @map("waiver_version")
  signerType    SignerType @map("signer_type")
  userId        String?    @map("user_id")
  guestId       String?    @map("guest_id")
  signedAt      DateTime   @default(now()) @map("signed_at")
  ip            String?

  user User? @relation(fields: [userId], references: [id])

  @@map("waiver_signatures")
}

// Append-only log backing OTP rate limiting (per-phone, per-IP, and the
// global daily ceiling). Rows are never deleted — old rows simply age out
// of the lookback window used by each check.
model OtpSendAttempt {
  id        String   @id @default(cuid())
  phone     String
  ip        String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("otp_send_attempts")
}

// eventId isn't a real FK yet — the events table doesn't exist until Phase 1.
model EventLog {
  id            String   @id @default(cuid())
  actorUserId   String?  @map("actor_user_id")
  eventId       String?  @map("event_id")
  action        String
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  actorUser User? @relation(fields: [actorUserId], references: [id])

  @@map("event_log")
}
